# Salin menjadi .env.production lalu isi semua nilai <...>. File .env.production tidak di-commit.
# APP_KEY: docker compose run --rm --no-deps --entrypoint php app artisan key:generate --show

APP_NAME="Apotek Multi Cabang"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
# daily = file di volume storage, stderr = terlihat di "docker compose logs app"
LOG_STACK=daily,stderr
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# --- PostgreSQL superuser (hanya dipakai container db saat inisialisasi) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<superuser-kuat>

# --- Basis data aplikasi ---
DB_CONNECTION=pgsql
DB_DATABASE=apotek_prod
DB_SSLMODE=disable
# Owner: hanya untuk migrasi (CLI), tidak dipakai request web
DB_USERNAME=apotek_owner
DB_PASSWORD=<owner-kuat>
# Akun per peran (dibuat otomatis oleh docker/postgres/init/01-akun.sh)
DB_LOGIN_USERNAME=apotek_login
DB_LOGIN_PASSWORD=<login-kuat>
DB_ADMIN_USERNAME=apotek_admin
DB_ADMIN_PASSWORD=<admin-kuat>
DB_APOTEKER_USERNAME=apotek_apoteker
DB_APOTEKER_PASSWORD=<apoteker-kuat>
DB_KASIR_USERNAME=apotek_kasir
DB_KASIR_PASSWORD=<kasir-kuat>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Ubah ke true setelah situs memakai HTTPS (kalau true di HTTP, login tidak bisa)
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=12

# Batas atas monitoring resource
MONITOR_BATAS_CPU=85
MONITOR_BATAS_MEMORI=85
MONITOR_BATAS_KONEKSI=80
MONITOR_BATAS_DISK=85
MONITOR_BATAS_QUERY_MS=1500

# Migrasi + GRANT otomatis saat container app start
RUN_MIGRATIONS=true
# true HANYA untuk demo pertama kali (data contoh + akun kata sandi "password")
RUN_SEED=false

# Port, nama project, dan file env diatur di file ".env" milik docker compose (lihat docker-compose.yml)
